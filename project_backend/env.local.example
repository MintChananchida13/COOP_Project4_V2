DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ocr_studio
GATEWAY_URL=http://127.0.0.1:8080
MODEL_GATEWAY_API_KEY=replace-with-model-gateway-api-key
OCR_MEMORY_DIAGNOSTICS=true
# Fernet key used to encrypt external OCR API keys before storing them in the database.
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the same value across backend restarts and instances.
EXTERNAL_OCR_ENCRYPTION_KEY=
